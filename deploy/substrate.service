[Unit]
Description=Substrate execution daemon
RequiresMountsFor=/var/lib/substrate /var/lib/mantle/secrets
ConditionFileNotEmpty=/var/lib/mantle/secrets/claude

[Service]
Type=exec
User=substrate
Group=substrate
Delegate=yes
DelegateSubgroup=daemon
RuntimeDirectory=substrate
RuntimeDirectoryMode=0711
UMask=0077
ExecStart=/usr/local/bin/substrate-daemon \
    --socket /run/substrate/substrate.sock \
    --state /var/lib/substrate/state/state.db \
    --workspaces /var/lib/substrate/workspaces \
    --deployment mantle-worker \
    --allow-uid 1000 \
    --cgroup-root /sys/fs/cgroup/system.slice/substrate.service \
    --secret-slot claude=/var/lib/mantle/secrets/claude \
    --egress-aperture egress=127.0.0.1:3128/tcp \
    --ca-bundle /etc/ssl/certs/ca-certificates.crt
ExecStartPost=+/bin/sh -c 'until [ "$$(stat -c %%a /run/substrate/substrate.sock 2>/dev/null)" = 600 ]; do sleep 0.2; done; exec /usr/bin/setfacl -m u:1000:rw /run/substrate/substrate.sock'
TimeoutStartSec=300
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/substrate
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
